---
import IdeaGenerator from '../islands/IdeaGenerator/index.tsx';
import BusinessGenerator from '../islands/BusinessGenerator/index.tsx';
import ProductGenerator from '../islands/ProductGenerator/index.tsx';
import AttributeListing from '../islands/AttributeListing/index.tsx';
import KillTheIdea from '../islands/Games/KillTheIdea/index.tsx';
import Inspiral from '../islands/Games/Inspiral/index.tsx';
import WheelOfDistraction from '../islands/Games/WheelOfDistraction/index.tsx';
import Scavengers from '../islands/Games/Scavengers/index.tsx';
import WhatsYourProblem from '../islands/Games/WhatsYourProblem/index.tsx';
import IdeaSpaghetti from '../islands/Games/IdeaSpaghetti/index.tsx';
import FarOut from '../islands/Games/FarOut/index.tsx';
import ShoeSwapper from '../islands/Games/ShoeSwapper/index.tsx';
import HowToPlay from '../islands/Games/HowToPlay/index.tsx';
import BrainFlash from '../islands/Games/BrainFlash/index.tsx';
import AllTogetherNow from '../islands/Games/AllTogetherNow/index.tsx';
import BlastOff from '../islands/Games/BlastOff/index.tsx';
import IdeaScorer from '../islands/IdeaScorer/index.tsx';
import PerspectiveCards from '../islands/PerspectiveCards/index.tsx';
import ReverseBrainstorm from '../islands/ReverseBrainstorm/index.tsx';
import ChapterDice from '../islands/ChapterDice/index.tsx';
import EmpathyMap from '../islands/EmpathyMap/index.tsx';
import MindMap from '../islands/MindMap/index.tsx';
import CreativityTest from '../islands/CreativityTest/index.tsx';
import Notebook from '../islands/Notebook/index.tsx';
import PipelineStrip from '../islands/shared/PipelineStrip.tsx';
import book from '../data/book.json';
import { getAllPages } from '../lib/content';
import { normalizePath } from '../lib/keyword-map';

interface Props {
  /** Value of the page's `island` frontmatter. Each new tool adds one line below. */
  name: string;
}
const { name } = Astro.props;

// Pages that exist in this build, so a tool can link to a tool that is not published yet only when it is.
const livePaths = (await getAllPages()).map((p) => normalizePath(p.data.path));

// Tools that belong to the path from idea to launch show the strip above themselves.
const step = (
  {
    IdeaGenerator: 'generate',
    BusinessGenerator: 'generate',
    ProductGenerator: 'generate',
    AttributeListing: 'generate',
    IdeaSpaghetti: 'pile',
    Inspiral: 'pile',
    KillTheIdea: 'choose',
    IdeaScorer: 'choose',
    ReverseBrainstorm: 'generate',
    BlastOff: 'launch',
  } as Record<string, 'generate' | 'pile' | 'choose' | 'launch'>
)[name];
---

<!-- Static imports keep Astro's hydration working. The island renders on the server
     too, so the page already shows a real example without JavaScript (BRIEF §8.0). -->
{(step || name === 'Notebook') && <PipelineStrip client:idle current={step} livePaths={livePaths} />}
{name === 'IdeaGenerator' && <IdeaGenerator client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'BusinessGenerator' && <BusinessGenerator client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'ProductGenerator' && <ProductGenerator client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'AttributeListing' && <AttributeListing client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'KillTheIdea' && <KillTheIdea client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'Inspiral' && <Inspiral client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'WheelOfDistraction' && <WheelOfDistraction client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'Scavengers' && <Scavengers client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'WhatsYourProblem' && <WhatsYourProblem client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'IdeaSpaghetti' && <IdeaSpaghetti client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'FarOut' && <FarOut client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'ShoeSwapper' && <ShoeSwapper client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'HowToPlay' && <HowToPlay client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'BrainFlash' && <BrainFlash client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'AllTogetherNow' && <AllTogetherNow client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'BlastOff' && <BlastOff client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'IdeaScorer' && <IdeaScorer client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'PerspectiveCards' && <PerspectiveCards client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'ReverseBrainstorm' && <ReverseBrainstorm client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'ChapterDice' && <ChapterDice client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'EmpathyMap' && <EmpathyMap client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'MindMap' && <MindMap client:idle waitlistOpen={book.waitlistOpen} />}
{name === 'CreativityTest' &&<CreativityTest client:idle livePaths={livePaths} />}
{name === 'Notebook' && <Notebook client:idle livePaths={livePaths} />}
