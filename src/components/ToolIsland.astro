---
import IdeaGenerator from '../islands/IdeaGenerator/index.tsx';
import BusinessGenerator from '../islands/BusinessGenerator/index.tsx';
import ProductGenerator from '../islands/ProductGenerator/index.tsx';
import AttributeListing from '../islands/AttributeListing/index.tsx';
import KillTheIdea from '../islands/Games/KillTheIdea/index.tsx';
import Inspiral from '../islands/Games/Inspiral/index.tsx';
import WheelOfDistraction from '../islands/Games/WheelOfDistraction/index.tsx';
import Scavengers from '../islands/Games/Scavengers/index.tsx';
import WhatsYourProblem from '../islands/Games/WhatsYourProblem/index.tsx';
import IdeaSpaghetti from '../islands/Games/IdeaSpaghetti/index.tsx';
import FarOut from '../islands/Games/FarOut/index.tsx';
import ShoeSwapper from '../islands/Games/ShoeSwapper/index.tsx';
import CreativityTest from '../islands/CreativityTest/index.tsx';
import book from '../data/book.json';
import { getAllPages } from '../lib/content';
import { normalizePath } from '../lib/keyword-map';

interface Props {
  /** Value of the page's `island` frontmatter. Each new tool adds one line below. */
  name: string;
}
const { name } = Astro.props;

// Pages that exist in this build, so a tool can link to a tool that is not published yet only when it is.
const livePaths = (await getAllPages()).map((p) => normalizePath(p.data.path));
---

<!-- Static imports keep Astro's hydration working. The island renders on the server
     too, so the page already shows a real example without JavaScript (BRIEF §8.0). -->
{name === 'IdeaGenerator' && <IdeaGenerator client:load waitlistOpen={book.waitlistOpen} />}
{name === 'BusinessGenerator' && <BusinessGenerator client:load waitlistOpen={book.waitlistOpen} />}
{name === 'ProductGenerator' && <ProductGenerator client:load waitlistOpen={book.waitlistOpen} />}
{name === 'AttributeListing' && <AttributeListing client:load waitlistOpen={book.waitlistOpen} />}
{name === 'KillTheIdea' && <KillTheIdea client:load waitlistOpen={book.waitlistOpen} />}
{name === 'Inspiral' && <Inspiral client:load waitlistOpen={book.waitlistOpen} />}
{name === 'WheelOfDistraction' && <WheelOfDistraction client:load waitlistOpen={book.waitlistOpen} />}
{name === 'Scavengers' && <Scavengers client:load waitlistOpen={book.waitlistOpen} />}
{name === 'WhatsYourProblem' && <WhatsYourProblem client:load waitlistOpen={book.waitlistOpen} />}
{name === 'IdeaSpaghetti' && <IdeaSpaghetti client:load waitlistOpen={book.waitlistOpen} />}
{name === 'FarOut' && <FarOut client:load waitlistOpen={book.waitlistOpen} />}
{name === 'ShoeSwapper' && <ShoeSwapper client:load waitlistOpen={book.waitlistOpen} />}
{name === 'CreativityTest' && <CreativityTest client:load livePaths={livePaths} />}
