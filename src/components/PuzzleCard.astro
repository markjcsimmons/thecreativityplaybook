---
import type { Puzzle } from '../lib/schemas';

interface Props {
  puzzle: Puzzle;
  techniquePath?: string;
}
const { puzzle, techniquePath } = Astro.props;
---

<article class="sticker p-5" data-puzzle-id={puzzle.id}>
  <h3 class="!mt-0">{puzzle.title}</h3>
  <p class="m-0">{puzzle.setup}</p>
  <details class="mt-4" data-reveal="hint">
    <summary class="cursor-pointer font-slab font-bold">Need a hint?</summary>
    <ol class="mb-0 mt-2 pl-6">{puzzle.hints.map((h) => <li>{h}</li>)}</ol>
  </details>
  <details class="mt-3" data-reveal="answer">
    <summary class="cursor-pointer font-slab font-bold">Show the answer</summary>
    <p class="mb-0 mt-2">{puzzle.answer}</p>
    <p class="mb-0 mt-2 text-muted">
      <strong>The thinking move:</strong> {puzzle.thinkingMove}
      {techniquePath && <a href={techniquePath}> Learn the technique.</a>}
    </p>
  </details>
</article>

<script>
  import { track } from '../lib/analytics';

  document.querySelectorAll<HTMLDetailsElement>('[data-puzzle-id] details[data-reveal]').forEach((d) => {
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      const id = d.closest<HTMLElement>('[data-puzzle-id]')?.dataset.puzzleId ?? '';
      track('puzzle_reveal', { puzzle_id: id, hint_or_answer: d.dataset.reveal === 'hint' ? 'hint' : 'answer' });
    });
  });
</script>
