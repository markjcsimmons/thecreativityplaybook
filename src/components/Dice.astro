---
interface Props {
  value: 1 | 2 | 3 | 4 | 5 | 6;
  size?: number;
  color?: string;
}
const { value, size = 72, color = 'var(--accent)' } = Astro.props;

const SPOTS: Record<number, [number, number][]> = {
  1: [[50, 50]],
  2: [[28, 28], [72, 72]],
  3: [[28, 28], [50, 50], [72, 72]],
  4: [[28, 28], [72, 28], [28, 72], [72, 72]],
  5: [[28, 28], [72, 28], [50, 50], [28, 72], [72, 72]],
  6: [[28, 26], [72, 26], [28, 50], [72, 50], [28, 74], [72, 74]],
};
---

<svg width={size} height={size} viewBox="0 0 100 100" role="img" aria-label={`Die showing ${value}`}>
  <rect x="5" y="5" width="90" height="90" rx="18" fill={color} stroke="var(--line)" stroke-width="6"></rect>
  {SPOTS[value]!.map(([x, y]) => <circle cx={x} cy={y} r="8" fill="#111"></circle>)}
</svg>
