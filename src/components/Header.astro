---
interface Props {
  nav: { label: string; path: string }[];
}
const { nav } = Astro.props;
const here = Astro.url.pathname;
---

<header class="border-b-[3px] border-ink bg-paper">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
    <a href="/" class="font-display text-2xl uppercase leading-none tracking-wide text-ink no-underline">
      The Creativity <span class="fill px-1">Playbook</span>
    </a>
    {
      nav.length > 0 && (
        <nav aria-label="Main">
          <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 font-slab text-lg font-bold">
            {nav.map((l) => (
              <li>
                <a href={l.path} class="text-ink" aria-current={here === l.path ? 'page' : undefined}>
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>
