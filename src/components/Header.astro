---
interface Props {
  nav: { label: string; path: string }[];
}
const { nav } = Astro.props;
const here = Astro.url.pathname;
---

<header class="border-b-[3px] border-ink bg-paper">
  <div class="wrap flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
    <a href="/" class="font-display text-2xl uppercase leading-none tracking-wide text-ink no-underline">
      The Creativity <span class="fill px-1">Playbook</span>
    </a>
    {
      nav.length > 0 && (
        <nav aria-label="Main">
          <ul class="m-0 flex list-none flex-wrap gap-x-5 gap-y-1 p-0 font-slab text-lg font-bold">
            {nav.map((l) => (
              <li>
                <a href={l.path} class="text-ink" aria-current={here === l.path ? 'page' : undefined}>
                  {l.label}
                  {l.path === '/notebook/' && <span class="nb-count" data-notebook-count />}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<script>
  // Shows how many ideas are in the notebook next to its link. Nothing is sent anywhere.
  // It waits until the browser is idle and loads the notebook code then, so it never competes
  // with the first paint.
  const badge = document.querySelector('[data-notebook-count]');
  if (badge) {
    const start = () =>
      import('../lib/notebook').then(({ getNotes, onNotebookChange }) => {
        const show = () => {
          const n = getNotes().length;
          badge.textContent = n > 0 ? ` (${n})` : '';
        };
        show();
        onNotebookChange(show);
      });
    if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1500 });
    else setTimeout(start, 300);
  }
</script>
