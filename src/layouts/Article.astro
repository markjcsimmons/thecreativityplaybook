---
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookCallout from '../components/BookCallout.astro';
import EmailCapture from '../components/EmailCapture.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import chapters from '../data/chapters.json';
import { chapterIdFor, crumbsFor, getAllPages } from '../lib/content';
import { jsonLdForPage } from '../lib/seo';
import { normalizePath } from '../lib/keyword-map';
import type { PageData } from '../lib/schemas';

interface Props {
  page: PageData;
}
const { page } = Astro.props;

const titles = new Map((await getAllPages()).map((p) => [normalizePath(p.data.path), p.data.h1 ?? p.data.title]));
const crumbs = crumbsFor(page.path, titles);
const chapterId = chapterIdFor(page.bookChapter);
const accent = chapters.find((c) => c.id === chapterId)?.color;
const updated = page.updated.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const isHome = page.pageType === 'home';
---

<Base
  title={page.title}
  description={page.description}
  path={page.path}
  ogImage={page.ogImage}
  accent={accent}
  noindex={page.status !== 'published'}
  jsonLd={jsonLdForPage(page, Astro.site!, crumbs)}
>
  <article class="wrap-narrow pt-8">
    {!isHome && <Breadcrumbs crumbs={crumbs} />}
    <h1 class="mt-4">{page.h1 ?? page.title}</h1>
    <p class="m-0 font-slab text-2xl leading-snug">{page.intro ?? page.description}</p>
    <p class="mb-8 mt-3 text-sm text-muted">Updated <time datetime={page.updated.toISOString().slice(0, 10)}>{updated}</time></p>

    <slot name="before-body" />
    <div class="prose"><slot /></div>
    <slot name="after-body" />

    <BookCallout chapter={chapterId} />
    <EmailCapture source={`page:${page.path}`} />
    <RelatedLinks path={page.path} />
  </article>
</Base>
